{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eolent/eolent/main/spec/module.schema.json",
  "title": "Eolent module manifest",
  "description": "Describes what an Eolent module provides: permissions, features, settings, entities, events, UI contributions and localization. Draft 0.2.",
  "type": "object",
  "required": ["manifestVersion", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": {
      "description": "Version of this manifest format.",
      "const": "0.2"
    },
    "name": {
      "description": "Unique module name: lowercase segments separated by dots.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "version": {
      "description": "Semantic version of the module.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/permission" }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "settings": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "operations": {
      "description": "The API operations of the module, linked to the permission, feature and entity they use.",
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "agentTools": {
      "description": "Operations the module opts in to expose to AI agents as tools. Nothing is exposed unless listed here.",
      "type": "array",
      "items": { "$ref": "#/$defs/agentTool" }
    },
    "errors": {
      "description": "Error codes the module defines, as in the error format profile.",
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "ui": { "$ref": "#/$defs/ui" },
    "localization": { "$ref": "#/$defs/localization" }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$" },
        "versionRange": {
          "description": "Semantic version range, for example \">=1.0.0 <2.0.0\".",
          "type": "string"
        }
      }
    },
    "permission": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Dot-separated permission name, for example \"Identity.Users.Create\".",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "parent": {
          "description": "Name of the parent permission, if this one is nested.",
          "type": "string"
        },
        "scope": {
          "description": "Who can hold the permission. A host permission can only be held by host principals and never by a tenant role. The ancestors of a host permission are host permissions too.",
          "enum": ["tenant", "host"],
          "default": "tenant"
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["name", "valueType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "valueType": { "enum": ["boolean", "integer", "string"] },
        "default": { "type": ["boolean", "integer", "string"] }
      }
    },
    "setting": {
      "type": "object",
      "required": ["name", "valueType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "valueType": { "enum": ["boolean", "integer", "number", "string"] },
        "default": { "type": ["boolean", "integer", "number", "string"] },
        "scope": {
          "description": "Level at which the setting can be overridden.",
          "enum": ["global", "tenant", "user"],
          "default": "global"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "description": { "type": "string" },
        "tenancy": {
          "description": "Whether instances belong to a tenant.",
          "enum": ["none", "tenantScoped"],
          "default": "tenantScoped"
        },
        "softDelete": { "type": "boolean", "default": false },
        "auditing": { "type": "boolean", "default": true },
        "sensitiveProperties": {
          "description": "Names of properties, as in the API representation, that hold sensitive values. The audit log records them as redacted and events do not carry them.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "uniqueItems": true
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["operationId", "method", "path"],
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "The operationId of the API description, for example \"identityUsersCreate\".",
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/api/v1/" },
        "description": { "type": "string" },
        "permission": {
          "description": "Permission the caller needs (x-eolent-permission). Omitted for operations that need none.",
          "type": "string"
        },
        "feature": {
          "description": "Boolean feature that must be on for the tenant (x-eolent-feature).",
          "type": "string"
        },
        "tenancy": {
          "description": "x-eolent-tenancy of the operation.",
          "enum": ["none", "tenantScoped"],
          "default": "tenantScoped"
        },
        "entity": {
          "description": "Entity of this module the operation reads or changes, if any.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        }
      }
    },
    "agentTool": {
      "type": "object",
      "required": ["operation", "description", "risk"],
      "additionalProperties": false,
      "properties": {
        "operation": { "description": "operationId of an operation declared in operations.", "type": "string" },
        "description": { "description": "What the tool does, written for a model that has to decide when to use it.", "type": "string", "minLength": 1 },
        "risk": {
          "description": "low: reads only. medium: changes data that can be undone. high: destructive, irreversible or security-relevant.",
          "enum": ["low", "medium", "high"]
        },
        "requiresApproval": {
          "description": "Whether a person must approve each call before it runs. Always true for medium and high risk (docs/adr/0008-agent-posture.md).",
          "type": "boolean",
          "default": false
        }
      },
      "if": { "properties": { "risk": { "enum": ["medium", "high"] } } },
      "then": { "required": ["requiresApproval"], "properties": { "requiresApproval": { "const": true } } }
    },
    "error": {
      "type": "object",
      "required": ["code", "status"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Error code starting with the module's PascalCase name, for example \"Identity.Users.EmailTaken\".",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)+$"
        },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "description": { "type": "string" },
        "arguments": {
          "description": "Names of the arguments that the code's messages can use, as extension properties of the problem details (spec/localization.md).",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "uniqueItems": true
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["name", "direction"],
      "if": { "properties": { "direction": { "const": "publishes" } } },
      "then": { "required": ["entity"], "properties": { "entity": true } },
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Event type name, for example \"identity.user.created\".",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "direction": { "enum": ["publishes", "subscribes"] },
        "entity": {
          "description": "Name of an entity declared in this module's entities that the event is about. It is required for published events and decides whether the event carries a tenant id (see spec/events.md).",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "description": { "type": "string" },
        "dataSchema": {
          "description": "Relative path or URI of a JSON Schema describing the event data.",
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "titleKey": { "type": "string" },
              "permission": { "type": "string" }
            }
          }
        },
        "menu": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "titleKey"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "titleKey": { "type": "string" },
              "route": { "type": "string", "pattern": "^/" },
              "permission": { "type": "string" },
              "order": { "type": "integer" },
              "parent": { "type": "string" }
            }
          }
        }
      }
    },
    "localization": {
      "type": "object",
      "required": ["defaultCulture"],
      "additionalProperties": false,
      "properties": {
        "defaultCulture": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
        "resources": {
          "description": "Relative paths of localization resource files, one per culture. The file name is the culture tag followed by .json (spec/localization.md).",
          "type": "array",
          "items": { "type": "string", "pattern": "^([A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[a-z]{2,3}(-[A-Za-z0-9]+)*\\.json$" }
        }
      }
    }
  }
}
