{
  "$schema": "../module.schema.json",
  "manifestVersion": "0.2",
  "name": "identity",
  "version": "0.1.0",
  "displayName": "Identity",
  "description": "Users, roles and permission assignment.",
  "dependencies": [
    { "name": "tenants", "versionRange": ">=0.1.0 <1.0.0" }
  ],
  "permissions": [
    { "name": "Identity.Users", "displayName": "User management" },
    { "name": "Identity.Users.Create", "displayName": "Create users", "parent": "Identity.Users" },
    { "name": "Identity.Roles", "displayName": "Role management" }
  ],
  "features": [
    { "name": "Identity.TwoFactor", "displayName": "Two-factor authentication", "valueType": "boolean", "default": false }
  ],
  "settings": [
    { "name": "Identity.Password.MinimumLength", "valueType": "integer", "default": 12, "scope": "tenant" }
  ],
  "entities": [
    { "name": "User", "tenancy": "tenantScoped", "softDelete": true, "auditing": true, "sensitiveProperties": ["password"] },
    { "name": "Role", "tenancy": "tenantScoped", "auditing": true }
  ],
  "events": [
    { "name": "identity.user.created", "direction": "publishes", "entity": "User", "dataSchema": "events/user-created.schema.json" }
  ],
  "operations": [
    { "operationId": "identityUsersList", "method": "GET", "path": "/api/v1/users", "permission": "Identity.Users", "entity": "User" },
    { "operationId": "identityUsersCreate", "method": "POST", "path": "/api/v1/users", "permission": "Identity.Users.Create", "entity": "User" },
    { "operationId": "identityUsersDelete", "method": "DELETE", "path": "/api/v1/users/{userId}", "permission": "Identity.Users", "entity": "User" },
    { "operationId": "identityUsersResetTwoFactor", "method": "POST", "path": "/api/v1/users/{userId}/actions/reset-two-factor", "permission": "Identity.Users", "feature": "Identity.TwoFactor", "entity": "User" }
  ],
  "agentTools": [
    { "operation": "identityUsersList", "description": "List the users of the current tenant, optionally filtered.", "risk": "low" },
    { "operation": "identityUsersCreate", "description": "Create a user in the current tenant.", "risk": "medium", "requiresApproval": true },
    { "operation": "identityUsersDelete", "description": "Delete a user. The user is soft-deleted and can be restored by an administrator.", "risk": "high", "requiresApproval": true }
  ],
  "errors": [
    { "code": "Identity.Users.EmailTaken", "status": 409, "description": "A user with this email address already exists in the tenant.", "arguments": ["email"] }
  ],
  "ui": {
    "routes": [
      { "path": "/identity/users", "titleKey": "Identity.Users", "permission": "Identity.Users" }
    ],
    "menu": [
      { "key": "identity", "titleKey": "Identity.Menu", "order": 10 },
      { "key": "identity.users", "titleKey": "Identity.Users", "route": "/identity/users", "permission": "Identity.Users", "parent": "identity" }
    ]
  },
  "localization": {
    "defaultCulture": "en",
    "resources": ["i18n/en.json", "i18n/cs.json"]
  }
}
