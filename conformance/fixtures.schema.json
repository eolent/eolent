{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eolent/eolent/main/conformance/fixtures.schema.json",
  "title": "Eolent conformance fixtures",
  "description": "Describes the test deployment that the conformance suite runs against: two tenants, the principals that can call it, and one tenant-scoped resource.",
  "type": "object",
  "required": ["fixturesVersion", "tenants", "principals", "resource"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "fixturesVersion": { "const": "0.1" },
    "tenants": {
      "description": "Two tenants that exist in the deployment.",
      "type": "object",
      "required": ["a", "b"],
      "additionalProperties": false,
      "properties": {
        "a": { "$ref": "#/$defs/tenant" },
        "b": { "$ref": "#/$defs/tenant" }
      }
    },
    "principals": {
      "description": "Callers. Tokens are read from the environment variable named in tokenEnv; they never appear in this file.",
      "type": "object",
      "required": ["tenantA", "tenantB"],
      "additionalProperties": false,
      "properties": {
        "tenantA": { "$ref": "#/$defs/principal" },
        "tenantB": { "$ref": "#/$defs/principal" },
        "host": {
          "description": "Optional host principal that does not hold the tenant-switching permission.",
          "$ref": "#/$defs/principal"
        }
      }
    },
    "resource": {
      "description": "A tenant-scoped collection with create and get-by-id that the tests create and read.",
      "type": "object",
      "required": ["collectionPath", "createBody"],
      "additionalProperties": false,
      "properties": {
        "collectionPath": { "type": "string", "pattern": "^/api/v1/[a-z][a-z0-9-]*$" },
        "createBody": { "type": "object" }
      }
    }
  },
  "$defs": {
    "tenant": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string" }
      }
    },
    "principal": {
      "type": "object",
      "required": ["tokenEnv"],
      "additionalProperties": false,
      "properties": {
        "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    }
  }
}
