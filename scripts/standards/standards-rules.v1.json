{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewBot standards rules file, version 1",
  "description": "The generated rules.yaml a standards repo publishes. Rule text must also contain at least 8 tokens (maximal runs of Unicode letters and digits after NFKC and lower-casing), which JSON Schema cannot express; the validator in @agent-platform/standards-schema enforces it and is the source of truth.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": 1 },
    "generatedFrom": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "appliesTo", "text", "source"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z]+-\\d+-R\\d+$" },
          "severity": { "enum": ["error", "warning"] },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "text": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
